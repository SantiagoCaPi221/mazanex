      "output_encoding": "no-op",
      "headers_to_pass": ["Authorization", "authorization", "Content-Type"],
      "backend": [{"url_pattern": "/api/profile/social/accept-request/{senderId}/{receiverId}", "encoding": "no-op", "host": ["http://profile-service:8082"]}]
