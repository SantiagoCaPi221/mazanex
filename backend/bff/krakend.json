{
  "version": 3,
  "port": 8080,
  "extra_config": {
    "security/cors": {
      "allow_origins": ["http://localhost:3000"],
      "allow_methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
      "allow_headers": ["Origin", "Authorization", "authorization", "Content-Type", "Accept"],
      "expose_headers": ["Content-Length"],
      "max_age": "12h"
    }
  },
  "endpoints": [
    {
      "endpoint": "/api/auth/register",
      "method": "POST",
      "output_encoding": "no-op",
      "headers_to_pass": ["Authorization", "authorization", "Content-Type"],
      "backend": [{"url_pattern": "/api/auth/register", "encoding": "no-op", "host": ["http://auth-service:8081"]}]
    },
    {
      "endpoint": "/api/auth/login",
      "method": "POST",
      "output_encoding": "no-op",
      "headers_to_pass": ["Authorization", "authorization", "Content-Type"],
      "backend": [{"url_pattern": "/api/auth/login", "encoding": "no-op", "host": ["http://auth-service:8081"]}]
    },
    {
      "endpoint": "/api/auth/users",
      "method": "GET",
      "output_encoding": "no-op",
      "headers_to_pass": ["Authorization", "authorization", "Content-Type"],
      "backend": [{"url_pattern": "/api/auth/users", "encoding": "no-op", "host": ["http://auth-service:8081"]}]
    },
    {
